{
  "name": "WW · 07 · Reporte diario (19:00)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 19 * * 1-6"
            }
          ]
        }
      },
      "name": "Días hábiles 19:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ ($env.WW_API_BASE || 'http://host.docker.internal:8787') }}/api/summary",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "name": "Resumen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        200,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "WW Sales API"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.WW_API_BASE || 'http://host.docker.internal:8787') }}/api/integrations/n8n/event",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ evento: 'reporte_diario', entidad: 'sistema', detalle: { kpis: $json.kpis, objetivo: $json.objetivo } }) }}",
        "options": {}
      },
      "name": "Registrar evento",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "WW Sales API"
        }
      }
    }
  ],
  "connections": {
    "Días hábiles 19:00": {
      "main": [
        [
          {
            "node": "Resumen",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Resumen": {
      "main": [
        [
          {
            "node": "Registrar evento",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "America/Mexico_City",
    "executionOrder": "v1"
  },
  "active": false,
  "meta": {
    "nota": "Registra el resumen del día como evento de auditoría (visible en el dashboard)."
  }
}
