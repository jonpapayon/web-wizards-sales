# Web Wizards Sales OS — variables (EJEMPLO, sin valores).
# Local: los secretos van en .dev.vars (creado por `bin/ww user` / `bin/ww token`, permisos 600, no versionado).
# Producción: `npx wrangler secret put NOMBRE` (lo hace una persona). Nunca valores reales en archivos del proyecto.

# --- Worker (Cloudflare o local con bin/ww dev)
AUTH_USERS=
WORKER_TOKEN=
N8N_TOKEN=
EVENTS_TOKEN=
DENUE_TOKEN=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# --- Investigador del Mac
WW_API_BASE=
WW_RESEARCH_NETWORK=

# --- Dashboard clásico (CSV)
WW_PORT=8765

# --- No conectados (requieren autorización)
GOOGLE_PLACES_API_KEY=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
